{
  "name": "crowveil/xboard-subscription-bridge",
  "description": "XBoard plugin for group-authorized external subscription aggregation",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "symfony/yaml": "^7.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Plugin\\ExternalNodeBridge\\": "ExternalNodeBridge/"
    }
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "license": "MIT",
  "authors": [
    {
      "name": "crowveil"
    }
  ],
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "format:check": "pint --test"
  }
}
